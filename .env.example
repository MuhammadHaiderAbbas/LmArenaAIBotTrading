# ---- Development environment (copy to .env and adjust) ----
ENVIRONMENT=development
DEBUG=true

# Generate with: openssl rand -hex 32
SECRET_KEY=dev-only-insecure-key-change-me-in-production-0123456789

# Docker Compose Postgres
POSTGRES_USER=aurex
POSTGRES_PASSWORD=aurex_dev_password
POSTGRES_DB=aurex
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://aurex:aurex_dev_password@localhost:5432/aurex

REDIS_URL=redis://localhost:6379/0

API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap identities — CHANGE THESE BEFORE ANY SHARED DEPLOYMENT
FIRST_ADMIN_EMAIL=admin@aurex.ai
FIRST_ADMIN_PASSWORD=ChangeMe!2026
DEMO_USER_EMAIL=demo@aurex.ai
DEMO_USER_PASSWORD=Demo!Aurex2026
DEFAULT_PAPER_BALANCE=100000
BASE_CURRENCY=GBP

# Product guardrails — Phase 1 is paper-only. Do not enable.
LIVE_TRADING_ENABLED=false
REAL_MONEY_ENABLED=false
